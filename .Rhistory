bold(j = c(1:2),
i = c(1:5)) %>%
width( j = 1, width = 1.5) %>%
width( j = 2, width = 1.5) %>%
# bg( bg = "lightblue", i = 1:5) %>% # Cor de fundo
add_footer_lines(
"Estão destacados em negrito os cinco produtos mais citados na tabela Sociológica do IFN. Nessa tabela possui somente os 20 produtos mais citados."
)
tabela_produtos_mais_citados
# Produtos mais citados
# Contando a frequência de uso por espécie
df_freq_socio_uso <- tab_socio_ride %>%
st_drop_geometry() %>% # Apagar Geometria
group_by(`NOME DESCRITO NO LSA`, PARTE_UTI) %>%
summarise(Frequencia = n(), .groups = 'drop')
# Criando a formatação desejada
df_formatado_socio_uso <- df_freq_socio_uso %>%
mutate(`NOME DESCRITO NO LSA` = ifelse(duplicated(`NOME DESCRITO NO LSA`), "", `NOME DESCRITO NO LSA`))
# Exibindo o resultado
# View(df_formatado_socio_uso)
# Identificando os índices onde o valor de NOME DESCRITO NO LSA muda
indices_especies <- which(!duplicated(df_formatado_socio_uso$`NOME DESCRITO NO LSA`))
# A linha horizontal será inserida acima dessas linhas
indices_especies_validos <- indices_especies[indices_especies > 2]
# Adicionando a linha horizontal acima de cada valor único de NOME DESCRITO NO LSA
flex_formatado_socio_uso <- df_formatado_socio_uso %>%
st_drop_geometry() %>%
filter(!`NOME DESCRITO NO LSA` == "Sem informação") %>%
flextable() %>%
set_header_labels(
`NOME DESCRITO NO LSA` = "Nome da Espécie - Popular",
PARTE_UTI = "Tipos de Usos",
Frequencia = "Frequência de Respostas"
) %>%
bold(part = "header") %>%
width(j = 1, width = 1.5) %>%
width(j = 2, width = 1.5) %>%
vline(j = c(1:3)) %>%
# Adicionando a linha horizontal acima de cada valor único de espécie
hline(i = indices_especies_validos - 1,  # A linha horizontal é colocada acima do índice
border = fp_border(color = "black", width = 1))
flex_formatado_socio_uso %>% export("TABELAS/tabela_sociologica_uso_por_especie.xlsx")
flex_formatado_socio_uso %>% rio::export("TABELAS/tabela_sociologica_uso_por_especie.xlsx")
flex_formatado_socio_uso %>% write_xlsx("TABELAS/tabela_sociologica_uso_por_especie.xlsx")
pacman::p_load(tidyverse, # pacote para manipulação de dados
rio, # pacote para importar e exportar dados
utils, # pacote base
downloader, # pacote para download de arquivos
sf, #pacote para manipulação de dados espaciais
geobr, # pacote para baixar shapefiles do Brasil
flextable, # pacote para criar tabelas
patchwork, # pacote para criar relatórios
ggpattern, # pacote para criar padrões
ggthemes, # pacote para criar temas
officer, # pacote para criar relatórios
writexl # pacote para exportar arquivos
)
