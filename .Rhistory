# Tabela
tabela_produtos_bio_mais_citados_ride <- produtos_bio_mais_citados_ride %>%
st_drop_geometry() %>%
flextable() %>%
set_header_labels(
scientificName = "Nome do Produto",
Quantidade = "Frequencia do Produto"
) %>%
bold(part="header") %>%
bold(j = c(1:2),
i = c(1:5)) %>%
width( j = 1, width = 1.5) %>%
width( j = 2, width = 1.5) %>%
bg( bg = "lightblue", i = 1:5) %>%
add_footer_lines(
"Estão destacados os cinco produtos mais citados na tabela Sociológica do IFN."
)
